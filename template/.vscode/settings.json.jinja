{
  // Rendered from the tools template: change it there, then `copier update`.
  // The rules live in the tools' own files (ruff.toml, pyrightconfig.json, ty.toml,
  // .markdownlint-cli2.jsonc), which `just check` reads too; this file only
  // says which binaries the editor runs.
{%- if use_python %}

  // The interpreter, and the tools uv locks into .venv (`just setup`) at the versions CI runs.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // No language server from the Python extension: ty serves completion, hover and
  // go-to; ty and basedpyright both report diagnostics, side by side, as `just check` does.
  "python.languageServer": "None",
  "basedpyright.importStrategy": "fromEnvironment",
  "basedpyright.disableLanguageServices": true,
  // ty and Ruff by path: a missing .venv is an error, not a silent fallback to the extension's own copy.
  "ty.path": ["${workspaceFolder}/.venv/bin/ty"],
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }{% if use_markdown %},{% endif %}
{%- endif %}
{%- if use_markdown %}

  // The markdownlint extension reads .markdownlint-cli2.jsonc but runs the engine it
  // bundles, which can be newer than the CLI the devShell pins: a rule the CLI does
  // not know yet can show in the editor only.
  "[markdown]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  }
{%- endif %}
}
