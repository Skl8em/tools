# Licensing of every file in this repository (https://reuse.software), checked
# by `just check`. A file's own SPDX header takes precedence over this default.
version = 1

[[annotations]]
path = "**"
precedence = "closest"
SPDX-FileCopyrightText = "{{ copyright_holder }}"
SPDX-License-Identifier = "{{ license }}"
